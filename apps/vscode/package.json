{
  "name": "gitgit",
  "displayName": "GitGit",
  "description": "Read-only Git investigation for VS Code.",
  "icon": "media/gitgit-marketplace.png",
  "publisher": "gitgit",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yunsang-Jeong/gitgit.git"
  },
  "homepage": "https://github.com/Yunsang-Jeong/gitgit",
  "bugs": {
    "url": "https://github.com/Yunsang-Jeong/gitgit/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "history",
    "search"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onView:gitgit.search",
    "onView:gitgit.investigation",
    "onFileSystem:gitgit-revision"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "GitGit does not start its helper or read repository data until the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GitGit requires a filesystem-backed Git worktree."
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "test": "npm run build && node --test dist-tests/tests/**/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitgit.refresh",
        "title": "Refresh Repository",
        "category": "GitGit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitgit.commit.clear",
        "title": "Clear Commit Highlights",
        "category": "GitGit"
      },
      {
        "command": "gitgit.search.run",
        "title": "Search History",
        "category": "GitGit",
        "icon": "$(search)"
      },
      {
        "command": "gitgit.search.rerun",
        "title": "Run Search Again",
        "category": "GitGit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitgit.search.filters",
        "title": "Configure Search Filters",
        "category": "GitGit",
        "icon": "$(filter)"
      },
      {
        "command": "gitgit.search.cancel",
        "title": "Cancel Search",
        "category": "GitGit",
        "icon": "$(close)"
      },
      {
        "command": "gitgit.search.clear",
        "title": "Clear Search Results",
        "category": "GitGit",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitgit.search.openWorkingFile",
        "title": "Open Working File",
        "category": "GitGit",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitgit.search.copyCommitId",
        "title": "Copy Commit ID",
        "category": "GitGit",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitgit",
          "title": "GitGit",
          "icon": "media/gitgit.svg"
        }
      ]
    },
    "views": {
      "gitgit": [
        {
          "id": "gitgit.search",
          "name": "Search Results"
        },
        {
          "id": "gitgit.investigation",
          "name": "File History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitgit.search",
        "contents": "Search commit messages, diffs, and paths.\n[Search History](command:gitgit.search.run)\n[Configure filters](command:gitgit.search.filters)",
        "when": "!gitgit.searchHasResults && !gitgit.searchRunning"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitgit.search.run",
          "when": "view == gitgit.search && !gitgit.searchRunning",
          "group": "navigation@1"
        },
        {
          "command": "gitgit.search.cancel",
          "when": "view == gitgit.search && gitgit.searchRunning",
          "group": "navigation@1"
        },
        {
          "command": "gitgit.search.filters",
          "when": "view == gitgit.search && !gitgit.searchRunning",
          "group": "navigation@2"
        },
        {
          "command": "gitgit.search.rerun",
          "when": "view == gitgit.search && gitgit.searchHasResults && !gitgit.searchRunning",
          "group": "1_modification@1"
        },
        {
          "command": "gitgit.search.clear",
          "when": "view == gitgit.search && gitgit.searchHasResults && !gitgit.searchRunning",
          "group": "1_modification@2"
        },
        {
          "command": "gitgit.refresh",
          "when": "view == gitgit.investigation",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitgit.search.openWorkingFile",
          "when": "view == gitgit.search && (viewItem == gitgit.searchMatchedFile || viewItem == gitgit.searchChangedFile)",
          "group": "inline@1"
        },
        {
          "command": "gitgit.search.openWorkingFile",
          "when": "view == gitgit.search && (viewItem == gitgit.searchMatchedFile || viewItem == gitgit.searchChangedFile)",
          "group": "navigation@1"
        },
        {
          "command": "gitgit.search.copyCommitId",
          "when": "view == gitgit.search && viewItem == gitgit.searchCommit",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitgit.search.openWorkingFile",
          "when": "false"
        },
        {
          "command": "gitgit.search.copyCommitId",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitGit",
      "properties": {
        "gitgit.blame.mode": {
          "type": "string",
          "enum": [
            "auto",
            "off",
            "activeLine",
            "visibleLines"
          ],
          "enumDescriptions": [
            "Show the active line unless VS Code native blame is enabled.",
            "Disable GitGit blame decorations.",
            "Show blame for the active line.",
            "Show blame for visible editor lines."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Controls GitGit line blame decorations."
        },
        "gitgit.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Ignore whitespace changes when calculating GitGit blame."
        }
      }
    },
    "colors": [
      {
        "id": "gitgit.commitChangeBackground",
        "description": "Background for lines changed by the selected GitGit commit.",
        "defaults": {
          "dark": "#2EA04326",
          "light": "#1A7F3726",
          "highContrast": "#3FB95040",
          "highContrastLight": "#1A7F3740"
        }
      },
      {
        "id": "gitgit.commitChangeOverview",
        "description": "Overview ruler marker for lines changed by the selected GitGit commit.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#3FB950",
          "highContrastLight": "#1A7F37"
        }
      },
      {
        "id": "gitgit.commitDeletionForeground",
        "description": "Marker for deletions made by the selected GitGit commit.",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#FF7B72",
          "highContrastLight": "#CF222E"
        }
      },
      {
        "id": "gitgit.commitDeletedFileBackground",
        "description": "Background for a historical file snapshot deleted by the selected GitGit commit.",
        "defaults": {
          "dark": "#F8514926",
          "light": "#CF222E26",
          "highContrast": "#FF7B7240",
          "highContrastLight": "#CF222E40"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.27.0",
    "typescript": "5.9.3"
  }
}
